# Credenciales y configuración (copiar a .env y rellenar AQUÍ, nunca en el repo)
# Ninguna de estas claves es necesaria para que la web se publique.

# --- Plataforma POD + checkout (Fourthwall, plan Free) ---
FOURTHWALL_SHOP_URL=https://<tu-tienda>.fourthwall.com
FOURTHWALL_API_TOKEN=
# Site ID / shop ID que aparece en el panel de Fourthwall (Ajustes > Tienda)
FOURTHWALL_SHOP_ID=

# --- Printful (si se conecta Printful a Fourthwall, o para pedidos manuales) ---
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=

# --- Stripe (solo si algún día se usa checkout propio; con Fourthwall NO hace falta) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails transaccionales alternativos (no necesarios con Fourthwall) ---
RESEND_API_KEY=
EMAIL_FROM=hola@llamamiento2359.com

# --- Analítica (opcional; la web funciona sin ella) ---
GA_MEASUREMENT_ID=

# --- GitHub Pages ---
GITHUB_REPO=ray86-dev/camisetas-interinos
